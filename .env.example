# ---- Vomtek API ----
PORT=4010
NODE_ENV=development

# MongoDB (docker compose maps 27019 on the host)
MONGODB_URI=mongodb://127.0.0.1:27019/vomtek

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://localhost:3110,http://127.0.0.1:3110

# Admin authentication
JWT_SECRET=dev-only-change-this-to-a-64-character-random-string
ADMIN_EMAIL=admin@vomtek.com
ADMIN_PASSWORD=VomtekAdmin!2026

# Seed editorial content, jobs and the demo project on boot
SEED_ON_BOOT=true

# Console logs "sent" mail in development. Swap for SMTP in production.
MAIL_TRANSPORT=console
MAIL_FROM="Vomtek Website <no-reply@vomtek.com>"
SALES_NOTIFY_EMAIL=support@vomtek.com
